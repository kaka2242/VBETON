/* ─────────────────────────────────────────────
   HERO
───────────────────────────────────────────── */
.vx-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
