  site.querySelectorAll('a[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var id = a.getAttribute('href');
      if (!id || id === '#') return;
      var target;
      try { target = document.querySelector(id); } catch (_) { return; }
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  /* ── Burger / Drawer ── */
  var burger = document.getElementById('vxBurger');
  var drawer = document.getElementById('vxDrawer');
  var drawerClose = document.getElementById('vxDrawerClose');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('open');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('open');
    if (burger) burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (burger) burger.addEventListener('click', openDrawer);
  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
  if (drawer) {
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeDrawer);
    });
  }

  /* ── Policy modal ── */
  var policy = document.getElementById('vxPolicy');
  var policyClose = document.getElementById('vxPolicyClose');
  var policyOpeners = [
    document.getElementById('vxPolicyOpen'),
    document.getElementById('vxPolicyOpenFooter')
  ];

  function openPolicy(e) {
    if (e) e.preventDefault();
    if (!policy) return;
    policy.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closePolicy() {
    if (!policy) return;
    policy.classList.remove('open');
    document.body.style.overflow = '';
  }

  policyOpeners.forEach(function (btn) {
    if (btn) btn.addEventListener('click', openPolicy);
  });
  if (policyClose) policyClose.addEventListener('click', closePolicy);
  if (policy) {
    policy.addEventListener('click', function (e) {
      if (e.target === policy) closePolicy();
    });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closePolicy();
  });

  /* ── Reveal on scroll ──
     Контент виден по умолчанию (см. CSS). Если что-то тут упадёт —
     try/catch не даёт этому сломать остальной скрипт (меню, FAQ, форму),
     а сам контент всё равно останется видимым, просто без анимации. */
  try {
    if ('IntersectionObserver' in window) {
      var reveals = site.querySelectorAll('.vx-reveal');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            e.target.classList.remove('pre');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function (el) {
        el.classList.add('pre');
        io.observe(el);
      });
    }
  } catch (err) {}

  /* ── FAQ accordion ── */
  site.querySelectorAll('.vx-faq__item').forEach(function (item) {
    var btn = item.querySelector('.vx-faq__btn');
    var ans = item.querySelector('.vx-faq__answer');
    if (!btn || !ans) return;
    btn.addEventListener('click', function () {
      var open = item.classList.contains('is-open');
      site.querySelectorAll('.vx-faq__item.is-open').forEach(function (other) {
        other.classList.remove('is-open');
        var a = other.querySelector('.vx-faq__answer');
        if (a) a.style.maxHeight = null;
      });
      if (!open) {
        item.classList.add('is-open');
        ans.style.maxHeight = ans.scrollHeight + 'px';
      }
    });
  });

  /* ── Services accordion ── */
  site.querySelectorAll('.vx-service').forEach(function (item) {
    var row = item.querySelector('.vx-service__row');
    var desc = item.querySelector('.vx-service__desc');
    if (!row || !desc) return;
    row.addEventListener('click', function () {
      var open = item.classList.contains('is-open');
      site.querySelectorAll('.vx-service.is-open').forEach(function (other) {
        other.classList.remove('is-open');
        other.querySelector('.vx-service__row').setAttribute('aria-expanded', 'false');
        var d = other.querySelector('.vx-service__desc');
        if (d) d.style.maxHeight = null;
      });
      if (!open) {
        item.classList.add('is-open');
        row.setAttribute('aria-expanded', 'true');
        desc.style.maxHeight = desc.scrollHeight + 'px';
      }
    });
  });

  /* ── Process steps accordion (mobile only, CSS no-ops on desktop) ── */
  site.querySelectorAll('.vx-step').forEach(function (item) {
    var head = item.querySelector('.vx-step__head');
    var desc = item.querySelector('.vx-step__desc');
    if (!head || !desc) return;
    head.addEventListener('click', function () {
      var open = item.classList.contains('is-open');
      site.querySelectorAll('.vx-step.is-open').forEach(function (other) {
        other.classList.remove('is-open');
        other.querySelector('.vx-step__head').setAttribute('aria-expanded', 'false');
        var d = other.querySelector('.vx-step__desc');
        if (d) d.style.maxHeight = null;
      });
      if (!open) {
        item.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
        desc.style.maxHeight = desc.scrollHeight + 'px';
      }
    });
  });

  /* ── Phone formatter ── */
  var phoneInput = document.getElementById('vxPhone');
  if (phoneInput) {
    phoneInput.addEventListener('input', function () {
      var digits = this.value.replace(/\D/g, '');
      if (!digits) { this.value = ''; return; }
      if (digits[0] === '8') digits = '7' + digits.slice(1);
      if (digits[0] !== '7') digits = '7' + digits;
      digits = digits.slice(0, 11);
      var f = '+7';
      if (digits.length > 1) f += ' (' + digits.slice(1, 4);
      if (digits.length >= 4) f += ') ' + digits.slice(4, 7);
      if (digits.length >= 7) f += '-' + digits.slice(7, 9);
      if (digits.length >= 9) f += '-' + digits.slice(9, 11);
      this.value = f;
    });
  }

  /* ── Form submit ── */
  var form = document.getElementById('vxContactForm');
  var status = document.getElementById('vxFormStatus');
  var consent = document.getElementById('vxConsent');

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = document.getElementById('vxName');
      var phone = document.getElementById('vxPhone');
      var digits = phone ? phone.value.replace(/\D/g, '') : '';

      if (!name || !name.value.trim()) { if (name) name.focus(); return; }
      if (digits.length !== 11) { if (phone) phone.focus(); return; }
      if (!consent || !consent.checked) {
        if (status) { status.style.display = 'block'; status.textContent = 'Подтвердите согласие.'; }
        return;
      }
      if (status) { status.style.display = 'block'; status.textContent = 'Спасибо! Заявка готова к отправке.'; }
    });
  }

})();
</script>
