  background: rgba(255,255,255,.08);
  border-color: rgba(255,255,255,.32);
}

.vx-btn__icon {
  font-size: 16px;
  font-weight: 400;
  line-height: 1;
}

.vx-hero__strip {
  position: absolute;
  z-index: 2;
  right: clamp(20px, 5.5vw, 88px);
  bottom: clamp(48px, 7vh, 96px);
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  background: rgba(20,20,20,.6);
  backdrop-filter: blur(20px);
  overflow: hidden;
}

.vx-hero__stat {
  padding: 16px 22px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.vx-hero__stat:last-child { border-bottom: 0; }

.vx-hero__stat strong {
  display: block;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.04em;
  line-height: 1;
  color: var(--white);
}

.vx-hero__stat span {
  display: block;
  margin-top: 4px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
}

/* ─────────────────────────────────────────────
   TICKER
───────────────────────────────────────────── */
.vx-ticker {
  overflow: hidden;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  height: 38px;
  display: flex;
  align-items: center;
}

.vx-ticker__track {
  display: flex;
  gap: 0;
  animation: vxTick 22s linear infinite;
  white-space: nowrap;
}

@keyframes vxTick {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.vx-ticker__item {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  padding: 0 28px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.32);
  flex-shrink: 0;
}

.vx-ticker__item::after {
  content: '';
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--gold);
  opacity: .5;
  flex-shrink: 0;
}

/* ─────────────────────────────────────────────
   ABOUT
───────────────────────────────────────────── */
.vx-about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 680px;
}

.vx-about__image {
  position: relative;
  overflow: hidden;
  background: var(--panel);
}

.vx-about__image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(8,8,8,.32) 0%, rgba(8,8,8,.1) 35%, rgba(8,8,8,.4) 100%);
  pointer-events: none;
}

.vx-about__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(.85) brightness(.92);
  transition: transform 1.1s var(--ease), filter .6s ease;
}

.vx-about__image:hover img {
  transform: scale(1.035);
  filter: saturate(.95) brightness(.96);
}

.vx-about__image-tag {
  position: absolute;
  z-index: 2;
  bottom: 20px;
  left: 20px;
  padding: 8px 14px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  background: rgba(8,8,8,.5);
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}

.vx-about__text {
  background: var(--surface);
  padding: clamp(52px, 7vw, 100px) clamp(32px, 5vw, 80px);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vx-section-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.vx-section-label::before {
  content: '';
  width: 20px;
  height: 1px;
  background: var(--gold);
  flex-shrink: 0;
}

.vx-h2 {
  font-size: clamp(38px, 4.8vw, 72px);
  font-weight: 800;
  line-height: .88;
  letter-spacing: -.055em;
  text-transform: uppercase;
  text-wrap: balance;
  margin-bottom: 28px;
}

.vx-body {
  color: var(--muted);
  font-size: clamp(15px, 1.25vw, 18px);
  line-height: 1.6;
  letter-spacing: -.01em;
  text-wrap: pretty;
  max-width: 56ch;
}

