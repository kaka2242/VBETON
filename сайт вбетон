}

.vx-bank__dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--brand, var(--gold));
  box-shadow: 0 0 10px color-mix(in srgb, var(--brand, var(--gold)) 55%, transparent);
  flex-shrink: 0;
}

.vx-bank:hover {
  border-color: color-mix(in srgb, var(--brand, var(--gold)) 45%, transparent);
  color: var(--white);
  background: color-mix(in srgb, var(--brand, var(--gold)) 8%, transparent);
}

/* ─────────────────────────────────────────────
   SERVICES
───────────────────────────────────────────── */
.vx-services {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--black);
}

.vx-container {
  width: min(1360px, calc(100% - clamp(40px, 11vw, 176px)));
  margin: 0 auto;
}

.vx-services__head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: end;
  margin-bottom: 60px;
}

.vx-services__list {
  border-top: 1px solid var(--line);
}

.vx-service {
  border-bottom: 1px solid var(--line);
}

.vx-service__row {
  width: 100%;
  display: grid;
  grid-template-columns: 60px 1fr 44px;
  align-items: center;
  min-height: 96px;
  border: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  text-align: left;
  text-decoration: none;
  color: var(--white);
  font: inherit;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: padding-left .38s var(--ease);
}

.vx-service__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity .4s ease, transform .55s ease;
}

.vx-service__row:hover { padding-left: 8px; }
.vx-service__row:hover .vx-service__bg { opacity: 1; transform: scale(1); }

.vx-service__idx,
.vx-service__name,
.vx-service__arrow {
  position: relative;
  z-index: 1;
}

.vx-service__idx {
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;
  transition: color .25s ease;
}

.vx-service__row:hover .vx-service__idx { color: var(--gold); }

.vx-service__name {
  font-size: clamp(24px, 3vw, 44px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: 1;
  transition: color .25s ease, transform .38s var(--ease);
}

.vx-service__row:hover .vx-service__name { transform: translateX(4px); }

.vx-service__arrow {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  font-size: 20px;
  font-weight: 300;
  justify-self: end;
  transition: background .25s ease, border-color .25s ease, transform .38s var(--ease), color .25s ease;
}

.vx-service__row:hover .vx-service__arrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-service.is-open .vx-service__arrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
  transform: rotate(45deg);
}

.vx-service__desc {
  max-height: 0;
  overflow: hidden;
  visibility: hidden;
  transition: max-height .4s ease;
}

.vx-service.is-open .vx-service__desc { visibility: visible; }

.vx-service__desc-inner {
  padding: 22px 44px 32px 60px;
  border-top: 1px solid var(--line);
}

.vx-service__desc p {
  color: var(--soft);
  font-size: 15px;
  line-height: 1.75;
  max-width: 56ch;
  text-wrap: pretty;
  margin-bottom: 20px;
  letter-spacing: -.005em;
}

.vx-service__desc p strong {
  color: var(--white);
  font-weight: 700;
}

.vx-service__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--gold);
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  border-bottom: 1px solid rgba(201,169,110,.4);
  padding-bottom: 3px;
  transition: color .2s ease, border-color .2s ease;
}

.vx-service__cta:hover {
  color: var(--gold2);
  border-color: var(--gold2);
}

/* ─────────────────────────────────────────────
   PROJECTS
───────────────────────────────────────────── */
.vx-projects {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--deep);
}

.vx-projects__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 48px;
}

.vx-projects__grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  grid-template-rows: auto auto;
  gap: 12px;
}

.vx-card {
  position: relative;
  overflow: hidden;
  background: var(--panel);
  cursor: pointer;
}

.vx-card--tall { grid-row: span 2; min-height: 680px; }
.vx-card--short { min-height: 320px; }

.vx-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  min-height: inherit;
  transition: transform 1.1s var(--ease), filter .5s ease;
  filter: saturate(.8);
}

.vx-card:hover img {
  transform: scale(1.06);
  filter: saturate(1);
}

.vx-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(8,8,8,.82));
  transition: opacity .4s ease;
}

.vx-card__info {
  position: absolute;
  z-index: 2;
  left: 24px;
  right: 24px;
  bottom: 22px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}

.vx-card__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,255,255,.5);
  margin-bottom: 6px;
}

.vx-card__name {
  font-size: clamp(22px, 2.8vw, 38px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: .92;
}

.vx-card--short .vx-card__name { font-size: clamp(20px, 2.2vw, 28px); }

.vx-card__btn {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 50%;
  font-size: 16px;
  transition: background .25s ease, color .25s ease, border-color .25s ease, transform .38s var(--ease);
}

.vx-card:hover .vx-card__btn {
  background: var(--white);
  color: var(--black);
  border-color: var(--white);
  transform: rotate(-45deg);
}

/* ─────────────────────────────────────────────
   PROCESS
───────────────────────────────────────────── */
.vx-process {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--black);
}

.vx-process__head {
  margin-bottom: 56px;
}

.vx-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
}

.vx-step {
  padding: 40px 32px 36px 0;
  border-right: 1px solid var(--line);
  position: relative;
  transition: background .3s ease;
}

.vx-step:hover { background: rgba(255,255,255,.025); }

.vx-step:nth-child(3n) { border-right: 0; }
.vx-step:nth-child(3n+2), .vx-step:nth-child(3n+3) { padding-left: 32px; }
.vx-step:nth-child(n+4) { border-top: 1px solid var(--line); }

.vx-step::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 2px;
  width: 0;
  background: var(--gold);
  transition: width .55s var(--ease);
}

.vx-step:hover::before { width: 100%; }

.vx-step__n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-bottom: 26px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 50%;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .02em;
  color: var(--gold);
  transition: background .3s ease, border-color .3s ease, color .3s ease, transform .38s var(--ease);
}

.vx-step:hover .vx-step__n {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
  transform: scale(1.06);
}

.vx-step__head {
  display: block;
  width: 100%;
  border: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  font: inherit;
  text-align: left;
  color: inherit;
  cursor: default;
}

.vx-step__title {
  display: block;
  font-size: clamp(22px, 2.4vw, 34px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: .94;
  margin-bottom: 16px;
  transition: transform .38s var(--ease);
}

.vx-step:hover .vx-step__title { transform: translateX(4px); }

.vx-step__arrow { display: none; }

.vx-step__desc {
  max-height: none;
  overflow: visible;
}

.vx-step__desc-inner { padding: 0; }

.vx-step__text {
  color: rgba(255,255,255,.5);
  font-size: 13.5px;
  line-height: 1.65;
  max-width: 30ch;
}

/* ─────────────────────────────────────────────
   FAQ
───────────────────────────────────────────── */
.vx-faq {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--surface);
}

.vx-faq__layout {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 80px;
  align-items: start;
}

.vx-faq__side { position: sticky; top: 100px; }

.vx-faq__list { border-top: 1px solid var(--line); }

.vx-faq__item { border-bottom: 1px solid var(--line); }

.vx-faq__btn {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 32px;
  align-items: center;
  min-height: 82px;
  background: transparent;
  border: 0;
  color: var(--white);
  text-align: left;
  cursor: pointer;
  gap: 20px;
  transition: padding-left .3s var(--ease);
}

.vx-faq__btn:hover { padding-left: 6px; }

.vx-faq__q {
  font-size: clamp(16px, 1.6vw, 22px);
  font-weight: 700;
  letter-spacing: -.025em;
  line-height: 1.1;
  font-family: inherit;
}

.vx-faq__plus {
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 300;
  flex-shrink: 0;
  transition: transform .3s var(--ease), background .25s ease, border-color .25s ease, color .25s ease;
}

.vx-faq__item.is-open .vx-faq__plus {
  transform: rotate(45deg);
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-faq__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height .38s ease;
}

.vx-faq__answer p {
  padding-bottom: 24px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
  max-width: 58ch;
  text-wrap: pretty;
}

/* ─────────────────────────────────────────────
   CTA FORM
───────────────────────────────────────────── */
.vx-cta {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--deep);
}

.vx-cta__layout {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 80px;
  align-items: center;
}

.vx-cta__img {
  position: relative;
  min-height: 560px;
  overflow: hidden;
  border-radius: 20px;
  background: var(--panel);
}

.vx-cta__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  min-height: 560px;
  filter: saturate(.8);
}

.vx-cta__img-overlay {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(8,8,8,.3), transparent 60%);
}

.vx-cta__form-area { max-width: 520px; }

.vx-form {
  margin-top: 36px;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', Arial, sans-serif;
}

.vx-form input,
.vx-form textarea,
.vx-form select { font: inherit; }

.vx-form__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.vx-form__group { margin-bottom: 12px; }

.vx-form label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.vx-form input,
.vx-form textarea {
  width: 100%;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  color: var(--white);
  padding: 14px 16px;
  font-size: 14px;
  outline: none;
  transition: border-color .2s ease, background .2s ease;
}

.vx-form textarea { min-height: 90px; resize: vertical; }

.vx-form input:focus,
.vx-form textarea:focus {
  border-color: rgba(201,169,110,.5);
  background: rgba(255,255,255,.07);
}

.vx-form input::placeholder,
.vx-form textarea::placeholder { color: rgba(255,255,255,.25); }

.vx-form__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 20px;
}

.vx-form__consent {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  max-width: 280px;
  color: rgba(255,255,255,.45);
  font-size: 11px;
  line-height: 1.5;
  cursor: pointer;
}

.vx-form__consent input[type="checkbox"] {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  margin-top: 1px;
  accent-color: var(--gold);
  padding: 0;
  border-radius: 3px;
}

.vx-form__submit {
  border: 0;
  cursor: pointer;
  white-space: nowrap;
}

.vx-form__status {
  display: none;
  margin-top: 16px;
  font-size: 12px;
  color: var(--gold);
}

/* ─────────────────────────────────────────────
   CONTACTS
───────────────────────────────────────────── */
.vx-contacts {
  padding: clamp(72px, 10vw, 140px) 0 clamp(52px, 7vw, 100px);
  background: var(--black);
}

.vx-contacts__layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}

.vx-contacts__list {
  margin-top: 44px;
  border-top: 1px solid var(--line);
}

.vx-contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78px;
  border-bottom: 1px solid var(--line);
  gap: 24px;
}

.vx-contact-item__label {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  flex-shrink: 0;
  min-width: 80px;
}

.vx-contact-item__val {
  color: var(--white);
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -.01em;
  transition: color .2s ease;
}

a.vx-contact-item__val:hover { color: var(--gold); }

.vx-contacts__visual {
  position: relative;
  min-height: 500px;
  border-radius: 20px;
  overflow: hidden;
  background: var(--panel);
}

.vx-map {
  position: absolute;
  inset: 0;
  background: #dbe6e2;
}

.vx-map--embed iframe,
.vx-map--embed ymaps {
  width: 100% !important;
  height: 100% !important;
  border: 0;
  display: block;
}

/* ─────────────────────────────────────────────
   FOOTER
───────────────────────────────────────────── */
.vx-footer {
  background: var(--surface);
  border-top: 1px solid var(--line);
  padding: 32px clamp(20px, 5.5vw, 88px);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
}

.vx-footer__brand {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--white);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -.045em;
}

.vx-footer__brand img {
  height: 22px;
  width: auto;
  display: block;
}

.vx-footer__copy {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .06em;
  text-align: center;
  line-height: 1.5;
}

.vx-footer__links {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.vx-footer__links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color .2s ease;
}

.vx-footer__links a:hover { color: var(--white); }

/* ─────────────────────────────────────────────
   BACK TO TOP
───────────────────────────────────────────── */
.vx-top {
  position: fixed;
  right: clamp(16px, 4vw, 32px);
  bottom: clamp(16px, 4vw, 32px);
  z-index: 400;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 14px;
  background: rgba(20,20,20,.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--white);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity .3s ease, transform .3s var(--ease), visibility .3s ease, background .2s ease, border-color .2s ease, color .2s ease;
  box-shadow: 0 8px 24px rgba(0,0,0,.35);
}

.vx-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: none;
}

.vx-top:hover {
  background: rgba(201,169,110,.14);
  border-color: rgba(201,169,110,.4);
  color: var(--gold2);
}

.vx-top:active {
  background: rgba(201,169,110,.22);
  border-color: rgba(201,169,110,.5);
}

/* ─────────────────────────────────────────────
   LIGHT SECTIONS (слоновая кость)
   Инвертируем текстовые токены на тёплый ivory-фон.
   --black/--deep/--surface/--panel НЕ трогаем — они используются
   и как "цвет текста на золотой/белой плашке" (кнопки, бейджи),
   а не только как фон секции; поэтому фон каждой секции
   переопределяется явно, точечно.
───────────────────────────────────────────── */
.vx-about.vx-light,
.vx-banks.vx-light,
.vx-process.vx-light,
.vx-faq.vx-light,
.vx-contacts.vx-light {
  background: var(--ivory);
  color: var(--ink);
  --white:  var(--ink);
  --muted:  var(--ink-muted);
  --soft:   var(--ink-soft);
  --line:   var(--ink-line);
  --gold:   var(--gold-deep);
  --gold2:  var(--gold-deep2);
}

.vx-about.vx-light .vx-about__text { background: var(--ivory); }
.vx-about.vx-light .vx-about__image-tag { color: rgba(255,255,255,.75); }

.vx-banks.vx-light .vx-bank { background: rgba(34,29,20,.035); }

.vx-process.vx-light .vx-step__n { border-color: var(--ink-line); }
.vx-process.vx-light .vx-step__text { color: var(--ink-muted); }

.vx-faq.vx-light .vx-faq__plus { border-color: var(--ink-line); }

/* Услуги — фон светлый, но карточка на hover показывает фото
   с тёмной подложкой, поэтому золото/текст в момент hover должны
   оставаться такими же, как на тёмной теме (не темнеем их). */
.vx-services.vx-light {
  background: var(--ivory);
  color: var(--ink);
  --white: var(--ink);
  --muted: var(--ink-muted);
  --soft:  var(--ink-soft);
  --line:  var(--ink-line);
}

.vx-services.vx-light .vx-section-label,
.vx-services.vx-light .vx-section-label::before,
.vx-services.vx-light .vx-service__cta { color: var(--gold-deep); }
.vx-services.vx-light .vx-service__cta { border-bottom-color: rgba(140,106,49,.4); }
.vx-services.vx-light .vx-service__cta:hover { color: var(--gold-deep2); }
.vx-services.vx-light .vx-service__arrow { border-color: var(--ink-line); }

.vx-services.vx-light .vx-service__row:hover,
.vx-services.vx-light .vx-service__row:active { color: #fff; }

/* ─────────────────────────────────────────────
   REVEAL
   Контент виден всегда по умолчанию. Анимация появления
   при скролле — необязательное усиление: если JS отработает,
   .vx-reveal на мгновение приглушается и проявляется красиво;
   если нет — контент просто виден без анимации, никогда не пропадает.
───────────────────────────────────────────── */
.vx-reveal.pre {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .7s var(--ease), transform .7s var(--ease);
}

.vx-reveal.in { opacity: 1; transform: none; }
.vx-d1 { transition-delay: .08s; }
.vx-d2 { transition-delay: .16s; }
.vx-d3 { transition-delay: .24s; }

/* ─────────────────────────────────────────────
   TOUCH / ACTIVE STATES
   (hover-эффекты не срабатывают на тач-экранах —
   дублируем ключевые реакции через :active)
───────────────────────────────────────────── */
.vx-btn:active { transform: translateY(0) scale(.96); }

.vx-nav__burger:active,
.vx-nav__cta:active { background: rgba(255,255,255,.18); }

.vx-nav__mobile-social:active,
