          <div class="vx-section-label">Контакты</div>
          <h2 class="vx-h2" id="vxContactsTitle">Давайте<br>поговорим.</h2>

          <div class="vx-contacts__list" style="margin-top:44px;">
            <div class="vx-contact-item">
              <span class="vx-contact-item__label">Телефон</span>
              <a class="vx-contact-item__val" href="tel:+78612345678">+7 (861) 234-56-78</a>
            </div>
            <div class="vx-contact-item">
              <span class="vx-contact-item__label">E-mail</span>
              <a class="vx-contact-item__val" href="mailto:info@vbeton.ru">info@vbeton.ru</a>
