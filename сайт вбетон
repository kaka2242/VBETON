  filter: saturate(.85) brightness(.92);
  transition: transform 1.1s var(--ease), filter .6s ease;
}

.vx-about__image:hover img {
  transform: scale(1.035);
  filter: saturate(.95) brightness(.96);
}

.vx-about__image-tag {
  position: absolute;
  z-index: 2;
  bottom: 20px;
  left: 20px;
  padding: 8px 14px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  background: rgba(8,8,8,.5);
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}

.vx-about__text {
  background: var(--surface);
  padding: clamp(52px, 7vw, 100px) clamp(32px, 5vw, 80px);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vx-section-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.vx-section-label::before {
  content: '';
  width: 20px;
  height: 1px;
  background: var(--gold);
  flex-shrink: 0;
}

.vx-h2 {
  font-size: clamp(38px, 4.8vw, 72px);
  font-weight: 800;
  line-height: .88;
  letter-spacing: -.055em;
  text-transform: uppercase;
  text-wrap: balance;
  margin-bottom: 28px;
}

.vx-body {
  color: var(--muted);
  font-size: clamp(15px, 1.25vw, 18px);
  line-height: 1.6;
  letter-spacing: -.01em;
  text-wrap: pretty;
  max-width: 56ch;
}

.vx-about__nums {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--line);
  gap: 0;
}

.vx-num {
  padding-right: 20px;
  border-right: 1px solid var(--line);
}

.vx-num:last-child { border-right: 0; padding-right: 0; }
.vx-num + .vx-num { padding-left: 20px; }

.vx-num__val {
  font-size: clamp(30px, 3.5vw, 48px);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1;
  color: var(--white);
}

.vx-num__desc {
  margin-top: 6px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  line-height: 1.4;
}

/* ─────────────────────────────────────────────
   BANKS / ESCROW
───────────────────────────────────────────── */
.vx-banks {
  padding: clamp(60px, 8vw, 120px) 0;
  background: var(--surface);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.vx-banks__head { max-width: 640px; }

.vx-banks__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-top: 44px;
}

.vx-bank {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 88px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,.03);
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  text-align: center;
  padding: 12px;
  transition: border-color .25s ease, color .25s ease, background .25s ease;
}

.vx-bank__dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--brand, var(--gold));
  box-shadow: 0 0 10px color-mix(in srgb, var(--brand, var(--gold)) 55%, transparent);
  flex-shrink: 0;
}

.vx-bank:hover {
  border-color: color-mix(in srgb, var(--brand, var(--gold)) 45%, transparent);
  color: var(--white);
  background: color-mix(in srgb, var(--brand, var(--gold)) 8%, transparent);
}

/* ─────────────────────────────────────────────
   SERVICES
───────────────────────────────────────────── */
.vx-services {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--black);
}

.vx-container {
  width: min(1360px, calc(100% - clamp(40px, 11vw, 176px)));
  margin: 0 auto;
}

.vx-services__head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: end;
  margin-bottom: 60px;
}

.vx-services__list {
  border-top: 1px solid var(--line);
}

.vx-service {
  border-bottom: 1px solid var(--line);
}

.vx-service__row {
  width: 100%;
  display: grid;
  grid-template-columns: 60px 1fr 44px;
  align-items: center;
  min-height: 96px;
  border: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  text-align: left;
  text-decoration: none;
  color: var(--white);
  font: inherit;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: padding-left .38s var(--ease);
}

.vx-service__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity .4s ease, transform .55s ease;
}

.vx-service__row:hover { padding-left: 8px; }
.vx-service__row:hover .vx-service__bg,
.vx-service.is-open .vx-service__bg { opacity: 1; transform: scale(1); }
.vx-service.is-open .vx-service__row { padding-left: 8px; }

.vx-service__idx,
.vx-service__name,
.vx-service__arrow {
  position: relative;
  z-index: 1;
}

.vx-service__idx {
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;
  transition: color .25s ease;
}

.vx-service__row:hover .vx-service__idx,
.vx-service.is-open .vx-service__idx { color: var(--gold); }

.vx-service__name {
  font-size: clamp(24px, 3vw, 44px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: 1;
  transition: color .25s ease, transform .38s var(--ease);
}

.vx-service__row:hover .vx-service__name,
.vx-service.is-open .vx-service__name { transform: translateX(4px); }

.vx-service__arrow {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  font-size: 20px;
  font-weight: 300;
  justify-self: end;
  transition: background .25s ease, border-color .25s ease, transform .38s var(--ease), color .25s ease;
}

.vx-service__row:hover .vx-service__arrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-service.is-open .vx-service__arrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
  transform: rotate(45deg);
}

.vx-service__desc {
  max-height: 0;
  overflow: hidden;
  visibility: hidden;
  transition: max-height .4s ease;
}

.vx-service.is-open .vx-service__desc { visibility: visible; }

.vx-service__desc-inner {
  padding: 22px 44px 32px 60px;
  border-top: 1px solid var(--line);
}

.vx-service__desc p {
  color: var(--soft);
  font-size: 15px;
  line-height: 1.75;
  max-width: 56ch;
  text-wrap: pretty;
  margin-bottom: 20px;
  letter-spacing: -.005em;
}

.vx-service__desc p strong {
  color: var(--white);
  font-weight: 700;
}

.vx-service__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--gold);
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  border-bottom: 1px solid rgba(201,169,110,.4);
  padding-bottom: 3px;
  transition: color .2s ease, border-color .2s ease;
}

.vx-service__cta:hover {
  color: var(--gold2);
  border-color: var(--gold2);
}

/* ─────────────────────────────────────────────
   PROJECTS
───────────────────────────────────────────── */
.vx-projects {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--deep);
}

.vx-projects__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 48px;
}

.vx-projects__grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  grid-template-rows: auto auto;
  gap: 12px;
}

.vx-card {
  position: relative;
  overflow: hidden;
  background: var(--panel);
  cursor: pointer;
}

.vx-card--tall { grid-row: span 2; min-height: 680px; }
.vx-card--short { min-height: 320px; }

.vx-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  min-height: inherit;
  transition: transform 1.1s var(--ease), filter .5s ease;
  filter: saturate(.8);
}

.vx-card:hover img {
  transform: scale(1.06);
  filter: saturate(1);
}

.vx-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(8,8,8,.82));
  transition: opacity .4s ease;
}

.vx-card__info {
  position: absolute;
  z-index: 2;
  left: 24px;
  right: 24px;
  bottom: 22px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}

.vx-card__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,255,255,.5);
  margin-bottom: 6px;
}

.vx-card__name {
  font-size: clamp(22px, 2.8vw, 38px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: .92;
}

.vx-card--short .vx-card__name { font-size: clamp(20px, 2.2vw, 28px); }

.vx-card__btn {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 50%;
  font-size: 16px;
  transition: background .25s ease, color .25s ease, border-color .25s ease, transform .38s var(--ease);
}

.vx-card:hover .vx-card__btn {
  background: var(--white);
  color: var(--black);
  border-color: var(--white);
  transform: rotate(-45deg);
}

/* ─────────────────────────────────────────────
   PROCESS
───────────────────────────────────────────── */
.vx-process {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--black);
}

.vx-process__head {
  margin-bottom: 56px;
}

.vx-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
}

.vx-step {
  padding: 40px 32px 36px 0;
  border-right: 1px solid var(--line);
  position: relative;
  transition: background .3s ease;
}

.vx-step:nth-child(3n) { border-right: 0; }
.vx-step:nth-child(3n+2), .vx-step:nth-child(3n+3) { padding-left: 32px; }
.vx-step:nth-child(n+4) { border-top: 1px solid var(--line); }

.vx-step::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 2px;
  width: 0;
  background: var(--gold);
  transition: width .55s var(--ease);
}

.vx-step__n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-bottom: 26px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 50%;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .02em;
  color: var(--gold);
  transition: background .3s ease, border-color .3s ease, color .3s ease, transform .38s var(--ease);
}

/* Hover-эффекты шагов — только на устройствах с настоящей мышью.
   На тач-экранах (телефон) :hover "залипает" после тапа и не снимается
   сам до тапа в другое место — кружок с номером оставался золотым даже
   после закрытия шага. Ограничиваем эффекты (hover: hover), чтобы на
   телефоне их не было вовсе, а открытие/закрытие управлялось только
   классом is-open (см. стрелку-крестик ниже — она так и сделана). */
@media (hover: hover) and (pointer: fine) {
  .vx-step:hover { background: rgba(255,255,255,.025); }
  .vx-step:hover::before { width: 100%; }
  .vx-step:hover .vx-step__n {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--black);
    transform: scale(1.06);
  }
}

.vx-step__head {
  display: block;
  width: 100%;
  border: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  font: inherit;
  text-align: left;
  color: inherit;
  cursor: default;
}

.vx-step__title {
  display: block;
  font-size: clamp(22px, 2.4vw, 34px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: .94;
  margin-bottom: 16px;
  transition: transform .38s var(--ease);
}

.vx-step:hover .vx-step__title { transform: translateX(4px); }

.vx-step__arrow { display: none; }

.vx-step__desc {
  max-height: none;
  overflow: visible;
}

.vx-step__desc-inner { padding: 0; }

.vx-step__text {
  color: rgba(255,255,255,.5);
  font-size: 13.5px;
  line-height: 1.65;
  max-width: 30ch;
}

/* ─────────────────────────────────────────────
   FAQ
───────────────────────────────────────────── */
.vx-faq {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--surface);
}

.vx-faq__layout {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 80px;
  align-items: start;
}

.vx-faq__side { position: sticky; top: 100px; }

.vx-faq__list { border-top: 1px solid var(--line); }

.vx-faq__item { border-bottom: 1px solid var(--line); }

.vx-faq__btn {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 32px;
  align-items: center;
  min-height: 82px;
  background: transparent;
  border: 0;
  color: var(--white);
  text-align: left;
  cursor: pointer;
  gap: 20px;
  transition: padding-left .3s var(--ease);
}

.vx-faq__btn:hover { padding-left: 6px; }

.vx-faq__q {
  font-size: clamp(16px, 1.6vw, 22px);
  font-weight: 700;
  letter-spacing: -.025em;
  line-height: 1.1;
  font-family: inherit;
}

.vx-faq__plus {
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 300;
  flex-shrink: 0;
  transition: transform .3s var(--ease), background .25s ease, border-color .25s ease, color .25s ease;
}

.vx-faq__item.is-open .vx-faq__plus {
  transform: rotate(45deg);
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-faq__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height .38s ease;
}

.vx-faq__answer p {
  padding-bottom: 24px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
  max-width: 58ch;
  text-wrap: pretty;
}

/* ─────────────────────────────────────────────
   CTA FORM
───────────────────────────────────────────── */
.vx-cta {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--deep);
}

.vx-cta__layout {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 80px;
  align-items: center;
}

.vx-cta__img {
  position: relative;
  min-height: 560px;
  overflow: hidden;
  border-radius: 20px;
  background: var(--panel);
}

.vx-cta__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  min-height: 560px;
  filter: saturate(.8);
}

.vx-cta__img-overlay {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(8,8,8,.3), transparent 60%);
}

.vx-cta__form-area { max-width: 520px; }

.vx-form__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 20px;
}

.vx-form__consent {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  max-width: 280px;
  color: rgba(255,255,255,.45) !important;
  font-size: 11px !important;
  line-height: 1.5 !important;
  cursor: pointer;
}

.vx-form__consent span { font-size: inherit !important; line-height: inherit !important; }

.vx-form__consent input[type="checkbox"] {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  margin-top: 1px;
  accent-color: var(--gold);
  padding: 0;
  border-radius: 3px;
  transition: box-shadow .2s ease, outline-color .2s ease;
}

.vx-form__consent--invalid input[type="checkbox"] {
  outline: 1.5px solid #e5484d;
  outline-offset: 2px;
  box-shadow: 0 0 0 4px rgba(229,72,77,.25);
  border-radius: 3px;
}

/* ─────────────────────────────────────────────
   TILDA-ФОРМА (родная форма Тильды, оформлена
   под тот же дизайн, что и раньше)
───────────────────────────────────────────── */
.vx-tilda-form {
  margin-top: 36px;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', Arial, sans-serif;
}

.vx-tilda-form .t-form__inputsbox {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  align-items: start;
}

.vx-tilda-form .t-input-group_ta,
.vx-tilda-form .t-form__errorbox-middle,
.vx-tilda-form .vx-form__foot {
  grid-column: 1 / -1;
}

.vx-tilda-form .t-input-group { margin: 0; }

.vx-tilda-form .t-input {
  width: 100% !important;
  box-sizing: border-box !important;
  background: rgba(255,255,255,.05) !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  border-radius: 10px !important;
  color: var(--white) !important;
  padding: 14px 16px !important;
  font-size: 14px !important;
  font-family: inherit !important;
  outline: none !important;
  transition: border-color .2s ease, background .2s ease !important;
}

.vx-tilda-form textarea.t-input { min-height: 90px; resize: vertical; }

.vx-tilda-form .t-input:focus {
  border-color: rgba(201,169,110,.5) !important;
  background: rgba(255,255,255,.07) !important;
}

.vx-tilda-form .t-input::placeholder { color: rgba(255,255,255,.25) !important; }

.vx-tilda-form .t-input.is-invalid {
  border-color: #e5484d !important;
}

.vx-tilda-form .t-input-error:empty {
  display: none !important;
}

.vx-tilda-form .t-input-error:not(:empty) {
  display: block !important;
  color: #e5484d !important;
  font-size: 11px !important;
  margin-top: 6px;
}

.vx-tilda-form .t-form__errorbox-wrapper { margin-top: 8px; }
.vx-tilda-form .t-form__errorbox-text { list-style: none; }
.vx-tilda-form .t-form__errorbox-item {
  display: none !important;
  background: none !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 0 !important;
}
.vx-tilda-form .t-form__errorbox-link,
.vx-tilda-form .t-form__errorbox-item {
  color: #e5484d !important;
  font-size: 12px !important;
  text-decoration: none;
  background: none !important;
}

.vx-tilda-form .t-form__submit { margin: 0; }

.vx-tilda-form .t-submit {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12px !important;
  height: 54px !important;
  padding: 0 24px !important;
  border: 0 !important;
  border-radius: 14px !important;
  cursor: pointer;
  font-size: 11px !important;
  font-weight: 800 !important;
  letter-spacing: .06em !important;
  text-transform: uppercase !important;
  white-space: nowrap;
  background: var(--gold) !important;
  color: var(--black) !important;
  box-shadow: 0 10px 34px rgba(201,169,110,.4) !important;
  transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .25s ease !important;
}

.vx-tilda-form .t-submit:hover {
  transform: translateY(-3px);
  background: var(--gold2) !important;
  box-shadow: 0 16px 46px rgba(201,169,110,.55) !important;
}

.vx-tilda-form .t-btnflex__text {
  font-size: inherit !important;
  font-weight: inherit !important;
  letter-spacing: inherit !important;
  text-transform: inherit !important;
  color: inherit !important;
}

/* Своё сообщение над формой убрали насовсем — на живом сайте оно
   иногда показывалось пустой рамкой без текста (несмотря на фикс),
   решили не рисковать и оставить единственным источником обратной
   связи родной попап Тильды ниже, который надёжно работает. */
.vx-tilda-form .t-form__successbox {
  display: none !important;
}

/* Родной попап Тильды после отправки формы — общий для всей страницы
   элемент, создаётся скриптом Тильды вне нашей вёрстки, найден через
   DevTools на живом сайте: #tildaformsuccesspopup-new. Пробовали
   прятать его через display:none — сайт после отправки переставал
   скроллиться насовсем. Похоже, кнопка «Хорошо»/крестик в попапе не
   только закрывает его, но и снимает собственную блокировку скролла
   страницы, которую Тильда ставит при открытии попапа; если попап
   спрятан, нажать эту кнопку невозможно, и блокировка остаётся
   навсегда. Поэтому попап должен оставаться видимым и рабочим —
   только максимально перекрашиваем его под тёмную/золотую тему сайта. */
#tildaformsuccesspopup-new {
  background: rgba(8,8,8,.75) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
}

#tildaformsuccesspopup-new .t-form-success-popup__wrapper {
  background: #141414 !important;
  border: 1px solid rgba(255,255,255,.1) !important;
  border-radius: 20px !important;
  box-shadow: 0 20px 60px rgba(0,0,0,.5) !important;
}

#tildaformsuccesspopup-new .t-form-success-popup__wrapper,
#tildaformsuccesspopup-new .t-form-success-popup__wrapper * {
  color: #f3ecda !important;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', Arial, sans-serif !important;
}

#tildaformsuccesspopup-new .t-form-success-popup__wrapper button {
  background: #c9a96e !important;
  color: #080808 !important;
  border: none !important;
  border-radius: 14px !important;
  font-weight: 800 !important;
  transition: background .2s ease, box-shadow .2s ease !important;
}

#tildaformsuccesspopup-new .t-form-success-popup__wrapper button:hover {
  background: #e8c98a !important;
  box-shadow: 0 10px 28px rgba(201,169,110,.4) !important;
}

/* Крестик закрытия в углу — обычно отдельная маленькая кнопка/иконка,
   не основная кнопка «Хорошо»; лишаем его золотого фона и рамки, чтобы
   он остался лёгким и нейтральным, как в остальных модалках сайта. */
#tildaformsuccesspopup-new .t-popup__close,
#tildaformsuccesspopup-new [class*="__close"],
#tildaformsuccesspopup-new button[class*="__close"],
#tildaformsuccesspopup-new button.t-popup__close {
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  color: rgba(243,236,218,.6) !important;
}

#tildaformsuccesspopup-new .t-popup__close:hover,
#tildaformsuccesspopup-new [class*="__close"]:hover,
#tildaformsuccesspopup-new button[class*="__close"]:hover,
#tildaformsuccesspopup-new button.t-popup__close:hover {
  color: #f3ecda !important;
}

/* ─────────────────────────────────────────────
   CONTACTS
───────────────────────────────────────────── */
.vx-contacts {
  padding: clamp(72px, 10vw, 140px) 0 clamp(52px, 7vw, 100px);
  background: var(--black);
}

.vx-contacts__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.vx-contacts__grid--main { grid-template-columns: repeat(4, 1fr); }

.vx-offices-heading { display: none; }

.vx-contact-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  padding: 28px 24px;
  border: 1px solid rgba(20,16,10,.75);
  border-radius: 16px;
  text-decoration: none;
  transition: border-color .25s ease, background .25s ease, transform .25s var(--ease);
}

a.vx-contact-card:hover {
  border-color: rgba(201,169,110,.5);
  background: rgba(255,255,255,.02);
  transform: translateY(-3px);
}

.vx-contacts.vx-light a.vx-contact-card:hover { background: rgba(34,29,20,.03); }

.vx-contact-card__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid var(--line);
  color: var(--gold);
  transition: background .25s ease, border-color .25s ease, color .25s ease;
}

.vx-contact-card__icon svg { width: 19px; height: 19px; }

a.vx-contact-card:hover .vx-contact-card__icon {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-contact-card__label {
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.vx-contact-card__val {
  color: var(--white);
  font-size: clamp(17px, 1.8vw, 20px);
  font-weight: 700;
  letter-spacing: -.02em;
  line-height: 1.3;
  word-break: break-word;
}

/* ─────────────────────────────────────────────
   FOOTER
───────────────────────────────────────────── */
.vx-footer {
  background: var(--surface);
  border-top: 1px solid var(--line);
  padding: 32px clamp(20px, 5.5vw, 88px);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24px;
}

.vx-footer__brand {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--white);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -.045em;
}

.vx-footer__brand img {
  height: 22px;
  width: auto;
  display: block;
}

.vx-footer__copy {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .06em;
  text-align: center;
  line-height: 1.5;
}

.vx-footer__links {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.vx-footer__links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color .2s ease;
}

.vx-footer__links a:hover { color: var(--white); }

/* ─────────────────────────────────────────────
   BACK TO TOP
───────────────────────────────────────────── */
.vx-top {
  position: fixed;
  right: clamp(16px, 4vw, 32px);
  bottom: clamp(16px, 4vw, 32px);
  z-index: 400;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 14px;
  background: rgba(20,20,20,.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--white);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity .3s ease, transform .3s var(--ease), visibility .3s ease, background .2s ease, border-color .2s ease, color .2s ease;
  box-shadow: 0 8px 24px rgba(0,0,0,.35);
}

.vx-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: none;
}

.vx-top:hover {
  background: rgba(201,169,110,.14);
  border-color: rgba(201,169,110,.4);
  color: var(--gold2);
}

.vx-top:active {
  background: rgba(201,169,110,.22);
  border-color: rgba(201,169,110,.5);
}

/* ─────────────────────────────────────────────
   LIGHT SECTIONS (слоновая кость)
   Инвертируем текстовые токены на тёплый ivory-фон.
   --black/--deep/--surface/--panel НЕ трогаем — они используются
   и как "цвет текста на золотой/белой плашке" (кнопки, бейджи),
   а не только как фон секции; поэтому фон каждой секции
   переопределяется явно, точечно.
───────────────────────────────────────────── */
.vx-about.vx-light,
.vx-banks.vx-light,
.vx-process.vx-light,
.vx-faq.vx-light,
.vx-contacts.vx-light {
  background: var(--ivory);
  color: var(--ink);
  --white:  var(--ink);
  --muted:  var(--ink-muted);
  --soft:   var(--ink-soft);
  --line:   var(--ink-line);
  --gold:   var(--gold-deep);
  --gold2:  var(--gold-deep2);
}

.vx-about.vx-light .vx-about__text { background: var(--ivory); }
.vx-about.vx-light .vx-about__image-tag { color: rgba(255,255,255,.75); }

.vx-banks.vx-light .vx-bank { background: rgba(34,29,20,.035); }

.vx-process.vx-light .vx-step__n { border-color: var(--ink-line); }
.vx-process.vx-light .vx-step__text { color: var(--ink-muted); }

.vx-faq.vx-light .vx-faq__plus { border-color: var(--ink-line); }

/* Услуги — фон светлый, но карточка на hover показывает фото
   с тёмной подложкой, поэтому золото/текст в момент hover должны
   оставаться такими же, как на тёмной теме (не темнеем их). */
.vx-services.vx-light {
  background: var(--ivory);
  color: var(--ink);
  --white: var(--ink);
  --muted: var(--ink-muted);
  --soft:  var(--ink-soft);
  --line:  var(--ink-line);
}

.vx-services.vx-light .vx-section-label,
.vx-services.vx-light .vx-section-label::before,
.vx-services.vx-light .vx-service__cta { color: var(--gold-deep); }
.vx-services.vx-light .vx-service__cta { border-bottom-color: rgba(140,106,49,.4); }
.vx-services.vx-light .vx-service__cta:hover { color: var(--gold-deep2); }
.vx-services.vx-light .vx-service__arrow { border-color: var(--ink-line); }

.vx-services.vx-light .vx-service__row:hover,
.vx-services.vx-light .vx-service__row:active,
.vx-services.vx-light .vx-service.is-open .vx-service__row { color: #fff; }

/* ─────────────────────────────────────────────
   REVEAL
   Анимация появления при скролле отключена (см. JS) — контент
   всегда виден сразу без opacity:0 и зависимости от IntersectionObserver.
───────────────────────────────────────────── */

/* ─────────────────────────────────────────────
   TOUCH / ACTIVE STATES
   (hover-эффекты не срабатывают на тач-экранах —
   дублируем ключевые реакции через :active)
───────────────────────────────────────────── */
.vx-btn:active { transform: translateY(0) scale(.96); }

.vx-nav__burger:active,
.vx-nav__cta:active { background: rgba(255,255,255,.18); }

.vx-nav__mobile-social:active,
.vx-nav__social-link:active { transform: scale(.92); }

.vx-service__row:active { padding-left: 8px; }
.vx-service__row:active .vx-service__bg { opacity: 1; transform: scale(1); }
.vx-service__row:active .vx-service__idx { color: var(--gold); }
.vx-service__row:active .vx-service__name { transform: translateX(4px); }
.vx-service__row:active .vx-service__arrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--black);
}

.vx-card:active img { transform: scale(1.05); filter: saturate(1); }
.vx-card:active .vx-card__btn {
  background: var(--white);
  color: var(--black);
  border-color: var(--white);
  transform: rotate(-45deg);
}

.vx-faq__btn:active { padding-left: 6px; }

.vx-drawer__nav a:active { color: var(--gold); }
.vx-drawer__foot-cta:active { background: var(--gold2); }
.vx-drawer__close:active { background: rgba(201,169,110,.12); }

.vx-bank:active {
  border-color: color-mix(in srgb, var(--brand, var(--gold)) 45%, transparent);
  color: var(--white);
  background: color-mix(in srgb, var(--brand, var(--gold)) 8%, transparent);
}

/* ─────────────────────────────────────────────
   RESPONSIVE — TABLET ≤900px
───────────────────────────────────────────── */
@media (max-width: 900px) {
  .vx-nav__links { display: none; }
  .vx-nav__cta { display: none; }
  .vx-nav__socials { display: none; }
  .vx-nav__burger { display: flex; }
  .vx-nav__mobile-socials { display: flex; }
  .vx-nav {
    grid-template-columns: auto 1fr auto;
    padding-left: 20px;
    padding-right: 12px;
  }

  .vx-banks__grid { grid-template-columns: repeat(2, 1fr); }

  .vx-contacts__grid { grid-template-columns: repeat(2, 1fr); }

  .vx-hero__strip { display: none; }

  .vx-hero__stat {
    padding: 14px 0 0;
    border-bottom: none;
    border-top: 1px solid var(--line);
  }

  .vx-about { grid-template-columns: 1fr; }
  .vx-about__image { min-height: 480px; }

  .vx-services__head { grid-template-columns: 1fr; gap: 24px; }

  .vx-service__bg { opacity: 1; transform: scale(1); }
  .vx-service__row::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8,8,8,.32);
  }
  .vx-services.vx-light .vx-service__row { color: #fff; }

  .vx-projects__grid { grid-template-columns: 1fr; }
  .vx-card--tall { min-height: 480px; grid-row: auto; }
  .vx-card--short { min-height: 260px; }

  .vx-steps { grid-template-columns: 1fr 1fr; }
  .vx-step:nth-child(3n) { border-right: 1px solid var(--line); }
  .vx-step:nth-child(even) { padding-left: 28px; border-right: 0; }
  .vx-step:nth-child(n+3) { border-top: 1px solid var(--line); }
  .vx-step:nth-child(odd) { padding-left: 0; }

  .vx-faq__layout { grid-template-columns: 1fr; gap: 40px; }
  .vx-faq__side { position: static; }

  .vx-cta__layout { grid-template-columns: 1fr; }
  .vx-cta__img { min-height: 380px; }


  .vx-footer { grid-template-columns: 1fr; text-align: center; }
  .vx-footer__links { justify-content: center; }
}

/* ─────────────────────────────────────────────
   RESPONSIVE — MOBILE ≤620px
───────────────────────────────────────────── */
@media (max-width: 620px) {
  .vx-top {
    width: 44px;
    height: 44px;
    right: 16px;
    bottom: max(16px, env(safe-area-inset-bottom));
  }

  .vx-nav {
    height: calc(58px + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    padding-left: 20px;
    padding-right: 12px;
    top: 0;
    left: 0;
    right: 0;
    border-radius: 0;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    background: rgba(6,6,6,.58);
    backdrop-filter: blur(34px) saturate(180%);
    -webkit-backdrop-filter: blur(34px) saturate(180%);
  }

  .vx-nav.scrolled { background: rgba(4,4,4,.84); }

  .vx-nav__logo { font-size: 16px; align-self: center; line-height: 1; }
  .vx-nav__logo-dot { width: 6px; height: 6px; margin-top: 0; }
  .vx-nav__logo-icon { height: 18px; }

  .vx-nav > nav { display: none !important; }

  .vx-nav__actions { gap: 16px; align-self: center; margin-left: auto; }

  .vx-nav__mobile-socials { gap: 5px; }

  .vx-nav__mobile-social {
    width: 44px;
    height: 44px;
  }

  .vx-nav__mobile-social svg { width: 20px; height: 20px; }

  .vx-nav__burger {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    align-self: center;
    margin-left: 0;
  }

  .vx-hero__bg {
    background-image: url("https://raw.githubusercontent.com/kaka2242/VBETON/claude/inspiring-feynman-bn3ys1/%D0%BC%D0%BE%D0%B1%D0%B8%D0%BB%D0%BA%D0%B0.jpg");
    background-position: center 30%;
  }

  .vx-hero__bg::after {
    background:
      linear-gradient(180deg, rgba(8,8,8,.42) 0%, rgba(8,8,8,.35) 30%, rgba(8,8,8,.48) 55%, rgba(8,8,8,.66) 78%, rgba(8,8,8,.88) 100%);
  }

  .vx-hero__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: max(36px, calc(env(safe-area-inset-bottom) + 20px));
    padding-top: calc(118px + env(safe-area-inset-top));
  }

  .vx-hero__title {
    font-size: clamp(23px, 6.8vw, 35px);
    line-height: 1.05;
    letter-spacing: -.03em;
    margin-bottom: 18px;
    text-shadow: 0 4px 26px rgba(0,0,0,.55), 0 10px 40px rgba(0,0,0,.35);
  }

  .vx-hero__sub {
    font-size: 15px;
    padding: 12px 18px;
    border-radius: 20px;
    margin-top: auto;
    margin-bottom: 30px;
    box-shadow: 0 14px 32px rgba(0,0,0,.35), 0 2px 8px rgba(0,0,0,.25);
    animation: vxSubPopIn 1.7s cubic-bezier(.4, 0, .2, 1) .35s both;
    transition: opacity .45s ease, transform .45s cubic-bezier(.4, 0, .2, 1);
  }

  @keyframes vxSubPopIn {
    0%   { opacity: 0; transform: translateY(-14px) scale(.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Плашка «прочитывается» и исчезает при скролле вниз, как сообщение —
     и плавно возвращается, если вернуться к самому верху страницы. */
  .vx-hero__sub--faded {
    opacity: 0;
    transform: translateY(-12px) scale(.95);
    pointer-events: none;
  }

  .vx-hero__btns { flex-direction: column; align-items: center; width: 100%; gap: 11px; }
  .vx-btn { justify-content: center; height: 54px; padding: 0 38px; border-radius: 14px; }

  .vx-container { width: calc(100% - 40px); }

  .vx-about__image { min-height: 275px; }
  .vx-about__text { padding: 40px 20px; }
  .vx-about__nums { grid-template-columns: repeat(3, 1fr); }
  .vx-num + .vx-num { padding-left: 12px; }
  .vx-num { padding-right: 12px; }
  .vx-num__val { font-size: 24px; }

  .vx-service__row { grid-template-columns: 32px 1fr 36px; min-height: 80px; }
  .vx-service__name { font-size: 20px; }
  .vx-service__desc-inner { padding: 18px 36px 24px 32px; }
  .vx-service__desc p { font-size: 14px; line-height: 1.7; }

  .vx-card--tall { min-height: 400px; }
  .vx-card--short { min-height: 230px; }
  .vx-card__info { left: 16px; right: 16px; bottom: 16px; }
  .vx-card__name { font-size: 22px; }

  .vx-steps { grid-template-columns: 1fr; border-top: 0; }
  .vx-step,
  .vx-step:nth-child(3n),
  .vx-step:nth-child(even),
  .vx-step:nth-child(n+4) {
    padding: 0;
    border-right: 0;
    border-bottom: 1px solid var(--line);
    border-top: 0;
  }
  .vx-step:last-child { border-bottom: 0; }

  .vx-step__head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    cursor: pointer;
  }
  .vx-step__n { margin-bottom: 0; width: 32px; height: 32px; font-size: 11px; flex-shrink: 0; }
  .vx-step__title { font-size: 17px; margin-bottom: 0; flex: 1; }
  .vx-step:hover .vx-step__title,
  .vx-step.is-open .vx-step__title { transform: none; }

  .vx-step__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border: 1px solid var(--ink-line);
    border-radius: 50%;
    font-size: 15px;
    font-weight: 300;
    color: var(--ink-muted);
    transition: transform .3s var(--ease), background .25s ease, border-color .25s ease, color .25s ease;
  }
  .vx-step.is-open .vx-step__arrow {
    transform: rotate(45deg);
    background: var(--gold-deep);
    border-color: var(--gold-deep);
    color: #fff;
  }

  .vx-step__desc {
    max-height: 0;
    overflow: hidden;
    transition: max-height .4s ease;
  }
  .vx-step__desc-inner { padding: 0 40px 20px 46px; }

  .vx-faq__q { font-size: 15px; }

  .vx-cta__layout { gap: 36px; }
  .vx-cta__img { min-height: 280px; border-radius: 14px; }
  .vx-cta__img img { min-height: 280px; }
  .vx-form__foot { flex-direction: column; align-items: stretch; }
  .vx-form__consent { max-width: none; }
  .vx-tilda-form .t-form__inputsbox { grid-template-columns: 1fr; }
  .vx-tilda-form .t-form__submit,
  .vx-tilda-form .t-submit { width: 100%; }
  .vx-tilda-form .t-submit { justify-content: center; }

  .vx-contacts__grid { grid-template-columns: 1fr; gap: 12px; }
  .vx-contact-card { padding: 22px 20px; }

  .vx-offices-heading {
    display: block;
    margin-top: 28px;
    margin-bottom: 4px;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -.02em;
    color: #1a1610;
  }

  .vx-footer { padding: 28px 20px; gap: 16px; }

  .vx-projects__head { flex-direction: column; align-items: flex-start; }
}

@media (max-width: 380px) {
  .vx-nav { left: 0; right: 0; height: calc(54px + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); border-radius: 0; padding-left: 12px; padding-right: 8px; }
  .vx-nav__logo-icon { height: 16px; }
  .vx-nav__mobile-socials { gap: 4px; }
  .vx-nav__mobile-social { width: 44px; height: 44px; }
  .vx-nav__mobile-social svg { width: 20px; height: 20px; }
  .vx-nav__burger { width: 44px; height: 44px; border-radius: 12px; }
  .vx-hero__title { font-size: clamp(20px, 7vw, 24px); }
  .vx-about__nums { grid-template-columns: 1fr; border-top: 1px solid var(--line); }
  .vx-num { border-right: 0; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .vx-num:last-child { border-bottom: 0; }
  .vx-num + .vx-num { padding-left: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .vx-site *, .vx-site *::before, .vx-site *::after {
    animation: none !important;
    transition-duration: .01ms !important;
  }
}

