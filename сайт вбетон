<style>
/* ─────────────────────────────────────────────
   RESET + ROOT
───────────────────────────────────────────── */
html, body { background: #080808; }


.vx-site,
.vx-site * { box-sizing: border-box; margin: 0; padding: 0; }
.vx-site input,
.vx-site textarea,
.vx-site select { font: inherit; }

.vx-site {
  --black:   #080808;
  --deep:    #0e0e0e;
  --surface: #141414;
  --panel:   #1a1a1a;
  --line:    rgba(255,255,255,.09);
  --muted:   rgba(255,255,255,.42);
  --soft:    rgba(255,255,255,.65);
  --white:   #ffffff;
  --gold:    #c9a96e;
  --gold2:   #e8c98a;
  --ease:    cubic-bezier(.22,1,.36,1);

  width: 100%;
  background: var(--black);
  color: var(--white);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', 'Segoe UI', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  isolation: isolate;
  overflow-x: clip;
}

/* ─────────────────────────────────────────────
   NAV — iOS DARK GLASS PILL (ALL SCREENS)
───────────────────────────────────────────── */
.vx-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 500;
  height: calc(60px + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  padding-left: max(20px, calc((100% - 1360px) / 2));
  padding-right: max(8px, calc((100% - 1360px) / 2));
  border: none;
  border-bottom: 1px solid rgba(255,255,255,.08);
  border-radius: 0;
  background: rgba(14,14,14,.55);
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  box-shadow: 0 8px 32px rgba(0,0,0,.4);
  transition: background .3s ease, border-color .3s ease, box-shadow .3s ease;
  overflow: hidden;
}

.vx-nav::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255,255,255,.05) 0%, transparent 60%);
  pointer-events: none;
}

.vx-nav.scrolled {
  background: rgba(8,8,8,.9);
  border-bottom-color: rgba(255,255,255,.10);
  box-shadow: 0 8px 40px rgba(0,0,0,.6);
}

.vx-nav__logo {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--white);
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -.05em;
  line-height: 1;
  position: relative;
  z-index: 2;
}

.vx-nav__logo-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold);
  flex-shrink: 0;
  box-shadow: 0 0 10px rgba(201,169,110,.6);
}

.vx-nav__links {
  display: flex;
  justify-content: center;
  gap: clamp(18px, 3vw, 46px);
  list-style: none;
  position: relative;
  z-index: 2;
}

.vx-nav__links a {
  color: var(--soft);
  text-decoration: none;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  transition: color .2s ease;
}

.vx-nav__links a:hover { color: var(--white); }

.vx-nav__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
  z-index: 2;
}

.vx-nav__socials {
  display: flex;
  align-items: center;
  gap: 4px;
  position: relative;
  z-index: 2;
}

.vx-nav__social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 10px;
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.7);
  text-decoration: none;
  transition: background .2s ease, border-color .2s ease, color .2s ease;
  flex-shrink: 0;
}

.vx-nav__social-link:hover {
  background: rgba(255,255,255,.12);
  border-color: rgba(255,255,255,.32);
  color: var(--white);
}

.vx-nav__social-link svg {
  width: 15px;
  height: 15px;
  fill: currentColor;
  display: block;
}

.vx-nav__cta {
  display: inline-flex;
  align-items: center;
  height: 40px;
  padding: 0 18px;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 12px;
  background: rgba(255,255,255,.07);
  color: var(--white);
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  backdrop-filter: blur(8px);
  transition: background .2s ease, border-color .2s ease;
  white-space: nowrap;
}

.vx-nav__cta:hover {
  background: rgba(255,255,255,.14);
  border-color: rgba(255,255,255,.38);
}

.vx-nav__mobile-socials {
  display: none;
  align-items: center;
  gap: 6px;
}

.vx-nav__mobile-social {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px;
  background: rgba(255,255,255,.05);
  color: rgba(255,255,255,.55);
  text-decoration: none;
  transition: background .2s ease, border-color .2s ease, color .2s ease;
  flex-shrink: 0;
}

.vx-nav__mobile-social:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.25);
  color: var(--white);
}

.vx-nav__mobile-social svg {
  width: 15px;
  height: 15px;
  fill: currentColor;
  display: block;
}

.vx-nav__burger {
  width: 44px;
  height: 44px;
  display: none;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 13px;
  background: rgba(255,255,255,.07);
  color: var(--white);
  cursor: pointer;
  flex-direction: column;
  gap: 5px;
  transition: background .2s ease;
  flex-shrink: 0;
  margin-left: auto;
}

.vx-nav__burger:hover { background: rgba(255,255,255,.13); }

.vx-nav__burger span {
  display: block;
  width: 18px;
  height: 1.5px;
  background: currentColor;
  border-radius: 2px;
  transition: transform .25s var(--ease), opacity .2s ease;
}

/* ─────────────────────────────────────────────
   MOBILE DRAWER
───────────────────────────────────────────── */
.vx-drawer {
  position: fixed;
  inset: 0;
  z-index: 600;
  display: flex;
  flex-direction: column;
  padding: 0 24px max(34px, env(safe-area-inset-bottom));
  background: rgba(6,6,6,.97);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity .28s ease, visibility .28s ease, transform .28s ease;
}

.vx-drawer.open {
  opacity: 1;
  visibility: visible;
  transform: none;
}

.vx-drawer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84px;
  flex-shrink: 0;
}

.vx-drawer__brand {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -.05em;
  color: var(--white);
  display: flex;
  align-items: center;
  gap: 8px;
}

.vx-drawer__close {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px;
  background: rgba(255,255,255,.06);
  color: var(--white);
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  transition: background .2s ease;
}

.vx-drawer__close:hover { background: rgba(255,255,255,.12); }

.vx-drawer__nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
}

.vx-drawer__nav a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64px;
  color: var(--white);
  text-decoration: none;
  font-size: clamp(26px, 7.5vw, 40px);
  font-weight: 800;
  letter-spacing: -.04em;
  border-bottom: 1px solid rgba(255,255,255,.07);
  transition: color .2s ease;
}

.vx-drawer__nav a:hover { color: var(--gold); }

.vx-drawer__nav a span {
  font-size: 14px;
  opacity: .3;
}

.vx-drawer__foot {
  flex-shrink: 0;
  padding-top: 24px;
}

.vx-drawer__foot-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56px;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 16px;
  color: var(--white);
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  background: rgba(255,255,255,.06);
  transition: background .2s ease, border-color .2s ease;
}

.vx-drawer__foot-cta:hover {
  background: rgba(201,169,110,.12);
  border-color: rgba(201,169,110,.4);
  color: var(--gold2);
}

/* ─────────────────────────────────────────────
   HERO
───────────────────────────────────────────── */
.vx-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  background: var(--black);
}

.vx-hero__bg {
  position: absolute;
  inset: 0;
  background-image: url("https://static.tildacdn.pub/tild6538-6438-4161-b131-333763386433/Generated_Image_Sept.jpg");
  background-size: cover;
  background-position: 55% center;
  transform: scale(1.04);
  transition: transform 8s var(--ease);
}

.vx-hero__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(8,8,8,.2) 0%, rgba(8,8,8,.05) 35%, rgba(8,8,8,.75) 72%, rgba(8,8,8,.96) 100%),
    linear-gradient(90deg, rgba(8,8,8,.45) 0%, transparent 55%);
}

.vx-hero__body {
  position: relative;
  z-index: 2;
  padding: max(110px, 14vh) clamp(20px, 5.5vw, 88px) clamp(48px, 7vh, 96px);
}

.vx-hero__label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 32px;
  padding: 6px 14px 6px 8px;
  border: 1px solid rgba(201,169,110,.3);
  border-radius: 999px;
  background: rgba(201,169,110,.08);
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.vx-hero__label-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 8px var(--gold);
  animation: vxPulse 2s ease-in-out infinite;
}

@keyframes vxPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(.8); }
}

.vx-hero__title {
  font-size: clamp(52px, 9.5vw, 96px);
  font-weight: 900;
  line-height: .84;
  letter-spacing: -.06em;
  text-transform: uppercase;
  text-wrap: balance;
  max-width: 1100px;
  margin-bottom: 28px;
}

.vx-hero__title em {
  font-style: normal;
  color: var(--gold);
}

.vx-hero__sub {
  max-width: 520px;
  color: var(--soft);
  font-size: clamp(14px, 1.3vw, 18px);
  line-height: 1.5;
  letter-spacing: -.01em;
  margin-bottom: 38px;
  text-wrap: pretty;
}

.vx-hero__btns {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.vx-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  height: 54px;
  padding: 0 24px;
  border-radius: 14px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-decoration: none;
  transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .25s ease;
  white-space: nowrap;
}

.vx-btn:hover { transform: translateY(-3px); }

.vx-btn--primary {
  background: var(--gold);
  color: var(--black);
  box-shadow: 0 8px 28px rgba(201,169,110,.32);
}

.vx-btn--primary:hover {
  background: var(--gold2);
  box-shadow: 0 14px 40px rgba(201,169,110,.48);
}

.vx-btn--ghost {
  border: 1px solid rgba(255,255,255,.25);
  background: rgba(255,255,255,.06);
  color: var(--white);
  backdrop-filter: blur(8px);
}

.vx-btn--ghost:hover {
  background: rgba(255,255,255,.12);
  border-color: rgba(255,255,255,.5);
}

.vx-btn__icon {
  font-size: 16px;
  font-weight: 400;
  line-height: 1;
}

.vx-hero__strip {
  position: absolute;
  z-index: 2;
  right: clamp(20px, 5.5vw, 88px);
  bottom: clamp(48px, 7vh, 96px);
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  background: rgba(20,20,20,.6);
  backdrop-filter: blur(20px);
  overflow: hidden;
}

.vx-hero__stat {
  padding: 16px 22px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.vx-hero__stat:last-child { border-bottom: 0; }

.vx-hero__stat strong {
  display: block;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.04em;
  line-height: 1;
  color: var(--white);
}

.vx-hero__stat span {
  display: block;
  margin-top: 4px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
}

/* ─────────────────────────────────────────────
   TICKER
───────────────────────────────────────────── */
.vx-ticker {
  overflow: hidden;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  height: 48px;
  display: flex;
  align-items: center;
}

.vx-ticker__track {
  display: flex;
  gap: 0;
  animation: vxTick 22s linear infinite;
  white-space: nowrap;
}

@keyframes vxTick {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.vx-ticker__item {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  padding: 0 28px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--muted);
  flex-shrink: 0;
}

.vx-ticker__item::after {
  content: '';
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--gold);
  opacity: .7;
  flex-shrink: 0;
}

/* ─────────────────────────────────────────────
   ABOUT
───────────────────────────────────────────── */
.vx-about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 680px;
}

.vx-about__image {
  position: relative;
  overflow: hidden;
  background: var(--panel);
}

.vx-about__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(.85);
  transition: transform 1.1s var(--ease), filter .6s ease;
}

.vx-about__image:hover img {
  transform: scale(1.035);
  filter: saturate(.95);
}

.vx-about__image-tag {
  position: absolute;
  bottom: 20px;
  left: 20px;
  padding: 8px 14px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  background: rgba(8,8,8,.5);
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}

.vx-about__text {
  background: var(--surface);
  padding: clamp(52px, 7vw, 100px) clamp(32px, 5vw, 80px);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vx-section-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.vx-section-label::before {
  content: '';
  width: 20px;
  height: 1px;
  background: var(--gold);
  flex-shrink: 0;
}

.vx-h2 {
  font-size: clamp(38px, 4.8vw, 72px);
  font-weight: 800;
  line-height: .88;
  letter-spacing: -.055em;
  text-transform: uppercase;
  text-wrap: balance;
  margin-bottom: 28px;
}

.vx-body {
  color: var(--muted);
  font-size: clamp(15px, 1.25vw, 18px);
  line-height: 1.6;
  letter-spacing: -.01em;
  text-wrap: pretty;
  max-width: 56ch;
}

.vx-about__nums {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--line);
  gap: 0;
}

.vx-num {
  padding-right: 20px;
  border-right: 1px solid var(--line);
}

.vx-num:last-child { border-right: 0; padding-right: 0; }
.vx-num + .vx-num { padding-left: 20px; }

.vx-num__val {
  font-size: clamp(30px, 3.5vw, 48px);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1;
  color: var(--white);
}

.vx-num__desc {
  margin-top: 6px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  line-height: 1.4;
}

/* ─────────────────────────────────────────────
   BANKS / ESCROW
───────────────────────────────────────────── */
.vx-banks {
  padding: clamp(60px, 8vw, 120px) 0;
  background: var(--surface);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.vx-banks__head { max-width: 640px; }

.vx-banks__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-top: 44px;
}

.vx-bank {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,.03);
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  text-align: center;
  padding: 12px;
  transition: border-color .25s ease, color .25s ease, background .25s ease;
}

.vx-bank:hover {
  border-color: rgba(201,169,110,.4);
  color: var(--white);
  background: rgba(201,169,110,.06);
}

/* ─────────────────────────────────────────────
   SERVICES
───────────────────────────────────────────── */
.vx-services {
  padding: clamp(72px, 10vw, 140px) 0;
  background: var(--black);
}

.vx-container {
  width: min(1360px, calc(100% - clamp(40px, 11vw, 176px)));
  margin: 0 auto;
}

.vx-services__head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: end;
  margin-bottom: 60px;
}

.vx-services__list {
  border-top: 1px solid var(--line);
}

.vx-service {
  display: grid;
  grid-template-columns: 60px 1fr 44px;
  align-items: center;
  min-height: 96px;
  border-bottom: 1px solid var(--line);
  text-decoration: none;
  color: var(--white);
  position: relative;
  overflow: hidden;
  transition: padding-left .38s var(--ease);
}

.vx-service__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity .4s ease, transform .55s ease;
}

.vx-service__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(8,8,8,.65);
}

.vx-service:hover { padding-left: 8px; }
.vx-service:hover .vx-service__bg { opacity: 1; transform: scale(1); }

.vx-service__idx,
.vx-service__name,
.vx-service__arrow {
  position: relative;
  z-index: 1;
}

.vx-service__idx {
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;
  transition: color .25s ease;
}

.vx-service:hover .vx-service__idx { color: var(--gold); }

.vx-service__name {
  font-size: clamp(24px, 3vw, 44px);
  font-weight: 800;
  letter-spacing: -.045em;
  text-transform: uppercase;
  line-height: 1;
  transition: color .25s ease, transform .38s var(--ease);
}

.vx-service:hover .vx-service__name { transform: translateX(4px); }

.vx-service__arrow {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  font-size: 15px;
  justify-self: end;
