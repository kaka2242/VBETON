  var tildaForm = document.getElementById('form4339331901');
  if (tildaForm) {
    function vxFormatPhone(digits) {
      if (!digits) return '';
      if (digits[0] === '8') digits = '7' + digits.slice(1);
      if (digits[0] !== '7') digits = '7' + digits;
      digits = digits.slice(0, 11);
      var f = '+7';
      if (digits.length > 1) f += ' (' + digits.slice(1, 4);
      if (digits.length >= 4) f += ') ' + digits.slice(4, 7);
      if (digits.length >= 7) f += '-' + digits.slice(7, 9);
      if (digits.length >= 9) f += '-' + digits.slice(9, 11);
      return f;
    }

    function vxSetFieldError(input, errorEl, message) {
      if (input) input.classList.toggle('is-invalid', !!message);
      if (errorEl) errorEl.textContent = message || '';
    }

    /* Собственный виджет маски Тильды (флаг + разбивка по цифрам)
       корректно грузится только внутри её родных блоков — в нашем
       кастомном блоке его CSS/JS не подключались и разметка наезжала
       друг на друга. Заменили на простое поле и форматируем вручную.
       Backspace на разделителе (пробел/скобка/тире) раньше просто
       переформатировал то же значение обратно — визуально казалось,
       что стирание залипает. Расширяем выделение на разделитель и
       цифру перед ним, чтобы один Backspace стирал реальную цифру —
       дальше стандартное удаление браузера и переформатирование в input. */
    tildaForm.addEventListener('keydown', function (e) {
      if (e.target.id !== 'input_6143215261581') return;
      if (e.key !== 'Backspace' || e.target.selectionStart !== e.target.selectionEnd) return;
      var pos = e.target.selectionStart;
      if (pos === 0 || /\d/.test(e.target.value[pos - 1])) return;
      var start = pos - 1;
      while (start > 0 && !/\d/.test(e.target.value[start - 1])) start--;
      if (start === 0) return;
      e.target.setSelectionRange(start - 1, pos);
    });

    tildaForm.addEventListener('input', function (e) {
      if (e.target.id === 'input_6143215261581') {
        e.target.value = vxFormatPhone(e.target.value.replace(/\D/g, ''));
        if (e.target.value.replace(/\D/g, '').length === 11) {
          vxSetFieldError(e.target, document.getElementById('error_6143215261581'), '');
        }
      } else if (e.target.id === 'input_6143215261580') {
        if (e.target.value.trim()) vxSetFieldError(e.target, document.getElementById('error_6143215261580'), '');
      }
    });

    tildaForm.addEventListener('change', function (e) {
      if (e.target.id !== 'vxConsentCheckbox') return;
      if (e.target.checked) {
        var label = document.getElementById('vxConsentLabel');
        if (label) label.classList.remove('vx-form__consent--invalid');
      }
    });

    /* Раньше мы блокировали клик по «Отправить» через preventDefault
       ТОЛЬКО из-за непроставленного чекбокса согласия — но preventDefault
       на клике по кнопке submit целиком отменяет отправку формы, так что
       даже встроенная проверка полей Тильды (имя/телефон) не успевала
       запуститься, и при пустой форме подсвечивался только чекбокс.
       Теперь проверяем сами все обязательные поля (имя, телефон) и
       согласие ДО того, как решаем, пропускать клик дальше к Тильде
       или нет — так подсвечивается сразу всё, что не заполнено. */
    tildaForm.addEventListener('click', function (e) {
      var submitBtn = e.target.closest('.t-submit');
      if (!submitBtn) return;

      var nameInput = document.getElementById('input_6143215261580');
      var phoneInput = document.getElementById('input_6143215261581');
      var consent = document.getElementById('vxConsentCheckbox');
      var consentLabel = document.getElementById('vxConsentLabel');
      var firstInvalid = null;

      var nameOk = !nameInput || nameInput.value.trim().length > 0;
      vxSetFieldError(nameInput, document.getElementById('error_6143215261580'), nameOk ? '' : 'Укажите имя');
      if (!nameOk && !firstInvalid) firstInvalid = nameInput;

      var phoneOk = !phoneInput || phoneInput.value.replace(/\D/g, '').length === 11;
      vxSetFieldError(phoneInput, document.getElementById('error_6143215261581'), phoneOk ? '' : 'Укажите корректный номер телефона');
      if (!phoneOk && !firstInvalid) firstInvalid = phoneInput;

      var consentOk = !consent || consent.checked;
      if (consentLabel) consentLabel.classList.toggle('vx-form__consent--invalid', !consentOk);
      if (!consentOk && !firstInvalid) firstInvalid = consent;

      if (!nameOk || !phoneOk || !consentOk) {
        e.preventDefault();
        e.stopPropagation();
        if (firstInvalid) firstInvalid.focus();
      } else {
        vxScrollBeforeSuccess = window.scrollY;
      }
    }, true);
  }

  /* ── Родной попап Тильды после отправки слегка проскраливал страницу
     вверх при появлении (похоже, из-за фокуса/блокировки скролла внутри
     собственного скрипта Тильды) — фиксируем скролл там, где он был
     прямо перед отправкой, в момент появления попапа. Попап Тильда
     создаёт динамически, поэтому если его ещё нет в DOM — ждём появления
     через MutationObserver на body. */
  var vxScrollBeforeSuccess = null;
  function vxWatchSuccessPopup(popup) {
    function vxMaybeRestoreScroll() {
      if (vxScrollBeforeSuccess !== null && popup.classList.contains('t-popup_show')) {
        var pos = vxScrollBeforeSuccess;
        vxScrollBeforeSuccess = null;
        /* Двойной rAF — ждём, пока применятся любые собственные сдвиги
           скролла/фокуса скрипта Тильды за этот и следующий кадр, и
           только потом восстанавливаем позицию — иначе Тильда может
           перебить нашу коррекцию своей уже после неё. */
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            window.scrollTo(0, pos);
          });
        });
        /* Тильда сбрасывает после успешной отправки только свои
           собственные поля (имя/телефон/комментарий) — чекбокс
           согласия не её поле, она о нём не знает, и он остаётся
           отмеченным. Снимаем галочку сами. */
        var consentAfterSuccess = document.getElementById('vxConsentCheckbox');
        if (consentAfterSuccess) consentAfterSuccess.checked = false;
      }
    }
    /* Если попап создаётся сразу с классом-показом (атомарно), то
       ждать изменения атрибута бессмысленно — оно уже произошло до
       того, как мы начали наблюдать. Поэтому проверяем сразу же при
       обнаружении элемента, а MutationObserver — на случай повторного
       открытия того же попапа без пересоздания узла. */
    vxMaybeRestoreScroll();
    new MutationObserver(vxMaybeRestoreScroll).observe(popup, { attributes: true, attributeFilter: ['class', 'style'] });
  }
  var existingSuccessPopup = document.getElementById('tildaformsuccesspopup-new');
  if (existingSuccessPopup) {
    vxWatchSuccessPopup(existingSuccessPopup);
  } else {
    var vxPopupWaiter = new MutationObserver(function () {
      var popup = document.getElementById('tildaformsuccesspopup-new');
      if (popup) {
        vxWatchSuccessPopup(popup);
        vxPopupWaiter.disconnect();
      }
    });
    vxPopupWaiter.observe(document.body, { childList: true, subtree: true });
  }

})();
</script>
