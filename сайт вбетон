     IntersectionObserver, когда блок приближается к экрану. */
  var serviceBgs = site.querySelectorAll('.vx-service__bg[data-bg]');
  if (serviceBgs.length) {
    if ('IntersectionObserver' in window) {
      var bgObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          el.style.backgroundImage = 'url("' + el.getAttribute('data-bg') + '")';
          el.removeAttribute('data-bg');
          bgObserver.unobserve(el);
        });
      }, { rootMargin: '600px 0px' });
      serviceBgs.forEach(function (el) { bgObserver.observe(el); });
    } else {
      serviceBgs.forEach(function (el) {
        el.style.backgroundImage = 'url("' + el.getAttribute('data-bg') + '")';
      });
    }
  }

  /* ── Count-up stats (150+ / 10 лет) при загрузке страницы ── */
  try {
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    site.querySelectorAll('.vx-count').forEach(function (el) {
      var target = parseInt(el.getAttribute('data-target'), 10) || 0;
      if (reduceMotion) { el.textContent = target; return; }
      var duration = 1400;
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target);
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  } catch (err) {}

  /* ── Smooth anchors ──
     Повторный вызов через 650мс подстраховывает от случаев, когда
     позиция секции чуть съезжает уже после начала анимации (картинка
