     видимого рывка, если она и так уже на месте, вызов ничего не меняет. */
  var anchorResettleTimer = null;
  function cancelAnchorResettle() {
    if (anchorResettleTimer) { clearTimeout(anchorResettleTimer); anchorResettleTimer = null; }
  }
  site.querySelectorAll('a[href^="#"]:not([href="#vxPolicy"]):not([href="#vxConsent"])').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var id = a.getAttribute('href');
      if (!id || id === '#') return;
      var target;
      try { target = document.querySelector(id); } catch (_) { return; }
      if (!target) return;
      e.preventDefault();
      cancelAnchorResettle();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      anchorResettleTimer = setTimeout(function () {
